# Required: the Stellar secret key your facilitator signs and sponsors with
FACILITATOR_STELLAR_PRIVATE_KEY=S...

# Optional (defaults shown)
STELLAR_NETWORK=stellar:testnet
MAX_TRANSACTION_FEE_STROOPS=200000
POSTGRES_PASSWORD=rialto
INGEST_TOKEN=
# embed-worker only: where the local embedding model's downloaded weights are
# cached (~90MB, first run only). docker-compose.yml sets this to a named
# volume so restarts don't re-download.
EMBEDDING_CACHE_DIR=
